# Oh-my-posh prompt (same theme as fish for consistency)
eval "$(oh-my-posh init zsh --config ~/.config/oh-my-posh/zheak.omp.json)"

# Add ~/.local/bin to PATH (for user-installed symlinks)
export PATH="$HOME/.local/bin:$PATH"

# Additional completions (from pacman package)
fpath+=/usr/share/zsh/site-functions
autoload -U compinit && compinit

# Fish-style arrow-key selection menu
zstyle ':completion:*' menu select

# Case-insensitive tab completion
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# Keybindings
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^[[3~' delete-char

# Syntax highlighting
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Autosuggestions
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

# History substring search (↑/↓ filter)
source /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down



export EDITOR="zed --wait"
export VISUAL="zed --wait"

# Permanently point pi and vmpi to the concrete configuration directory
export PI_CONFIG_DIR="$HOME/.config/pi"
export PI_CODING_AGENT_DIR="$HOME/.config/pi/agent"

# NVM
export NVM_DIR="/usr/share/nvm"
[ -s /usr/share/nvm/init-nvm.sh ] && . /usr/share/nvm/init-nvm.sh


