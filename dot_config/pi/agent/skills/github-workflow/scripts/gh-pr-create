#!/usr/bin/env bash
# Create a GitHub PR from stdin or a file.
#
# Usage:
#   gh-pr-create --title "My PR" [--base main] [--head feature-branch] \
#                [--label bug] [--label breaking-change] < body.md
#   gh-pr-create --title "My PR" --body-file body.md [--base main]
#   cat body.md | gh-pr-create --title "My PR"

set -euo pipefail

TITLE=""
BASE="main"
HEAD=""
BODY_FILE=""
LABELS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --title)
      TITLE="$2"; shift 2 ;;
    --base)
      BASE="$2"; shift 2 ;;
    --head)
      HEAD="$2"; shift 2 ;;
    --body-file|-f)
      BODY_FILE="$2"; shift 2 ;;
    --label)
      LABELS+=("$2"); shift 2 ;;
    *)
      echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

if [[ -z "$TITLE" ]]; then
  echo "Error: --title is required" >&2
  exit 1
fi

# Determine body source
BODY=""
if [[ -n "$BODY_FILE" ]]; then
  BODY=$(cat "$BODY_FILE")
elif [[ ! -t 0 ]]; then
  BODY=$(cat)
else
  echo "Error: provide body via --body-file, stdin pipe, or heredoc" >&2
  exit 1
fi

# Build gh command
CMD=("gh" "pr" "create" "--title" "$TITLE" "--body" "$BODY" "--base" "$BASE")
if [[ -n "$HEAD" ]]; then
  CMD+=("--head" "$HEAD")
fi
for label in "${LABELS[@]+"${LABELS[@]}"}"; do
  CMD+=("--label" "$label")
done

"${CMD[@]}"
