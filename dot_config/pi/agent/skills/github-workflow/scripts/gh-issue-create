#!/usr/bin/env bash
# Create a GitHub issue from stdin or a file.
#
# Usage:
#   gh-issue-create --title "My issue" [--label bug] [--label enhancement] < body.md
#   gh-issue-create --title "My issue" --body-file body.md [--label bug]
#   cat body.md | gh-issue-create --title "My issue"
#
# If no stdin and no --body-file, reads from stdin.

set -euo pipefail

TITLE=""
BODY_FILE=""
LABELS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --title)
      TITLE="$2"; shift 2 ;;
    --body-file|-f)
      BODY_FILE="$2"; shift 2 ;;
    --label)
      LABELS+=("$2"); shift 2 ;;
    *)
      echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

if [[ -z "$TITLE" ]]; then
  echo "Error: --title is required" >&2
  exit 1
fi

# Determine body source
BODY=""
if [[ -n "$BODY_FILE" ]]; then
  BODY=$(cat "$BODY_FILE")
elif [[ ! -t 0 ]]; then
  BODY=$(cat)
else
  echo "Error: provide body via --body-file, stdin pipe, or heredoc" >&2
  exit 1
fi

# Build gh command
CMD=("gh" "issue" "create" "--title" "$TITLE" "--body" "$BODY")
for label in "${LABELS[@]+"${LABELS[@]}"}"; do
  CMD+=("--label" "$label")
done

"${CMD[@]}"
